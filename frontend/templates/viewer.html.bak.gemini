{% extends "base.html" %}

{% block title %}Document Viewer - {{ document.original_name }}{% endblock %}

{% block head %}
    {{ super() }}
    {# Marked.js for markdown parsing - MUST BE INCLUDED if used by document-viewer.js #}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    {# Highlight.js for syntax highlighting - CSS #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/styles/github-dark.min.css"> {# You can choose a different theme here #}
{% endblock %}

{% block content %}
<div id="viewer-container" class="main-content-area viewer-grid" data-document-id="{{ document.id }}" data-original-name="{{ document.original_name }}">
    <header class="viewer-header">
        <h2>Document: {{ document.original_name }}</h2>
        <div id="toolbar" class="viewer-toolbar">
            <a href="/api/documents/{{ document.id }}/download" class="button secondary-button" id="download-pdf-btn" download="{{ document.original_name }}">Download PDF</a>
            <button class="button secondary-button" id="download-markdown-btn">Download Markdown</button>
            <button class="button secondary-button" id="edit-metadata-btn">Edit Details</button>
            <button class="button danger-button" id="delete-document-btn" data-document-id="{{ document.id }}">Delete Document</button>
        </div>
    </header>

    <div id="split-pane" class="split-pane">
        <div class="pane pdf-pane">
            <h3 class="pane-title">Original PDF</h3>
            {% if document.file_path %}
                <iframe id="pdf-viewer" src="/api/documents/{{ document.id }}/download" title="PDF Viewer" frameborder="0">
                    PDF not available or still processing.
                </iframe>
            {% else %}
                <div class="viewer-placeholder">PDF file not found on server or link broken.</div>
            {% endif %}
        </div>
        <div class="pane markdown-pane">
            <h3 class="pane-title">Converted Markdown</h3>
            <div id="markdown-viewer" class="markdown-body">
                <div class="viewer-placeholder" id="markdown-placeholder">Loading Markdown content...</div>
            </div>
        </div>
    </div>

    {% include "components/metadata_block.html" %}

    <section id="comments-section" class="comments-section">
        <h3>Comments/Notes</h3>
        <textarea id="document-notes" class="text-input" placeholder="Add your notes here...">{{ document.notes if document.notes else '' }}</textarea>
        <button id="save-notes-btn" class="button primary-button">Save Notes</button>
    </section>
</div>

{# Remove the hidden input if you're consistently using data-document-id on viewer-container #}
{# <input type="hidden" id="documentId" value="{{ document.id }}"> #}

{# Highlight.js for syntax highlighting - JavaScript. Load AFTER marked.js but BEFORE your custom JS #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/highlight.min.js"></script>
{# Your custom JavaScript. Change viewer.js to document-viewer.js #}
<script src="{{ url_for('static', filename='js/document-viewer.js') }}"></script>
{% endblock %}