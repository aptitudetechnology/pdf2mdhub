{% extends "base.html" %}
{% block content %}
<div class="container">
    <h1>PDF Document Upload & Conversion</h1>
    
    <div class="demo-section">
        <h3>1. File Selection</h3>
        <p>Drag & drop your PDF files here or click to select them for conversion and management.</p>
        <div id="drop-zone" class="drop-zone">
            <p class="drop-zone-text">Drag & drop files here</p>
            <p class="drop-zone-or">or</p>
            <label for="file-input" class="button primary-button">Select Files</label>
            <input type="file" id="file-input" multiple accept="application/pdf" style="display: none;">
        </div>
        <div id="fileStatus" class="status" style="display: none;"></div>
    </div>

    <div class="demo-section">
        <h3>2. Selected Files</h3>
        <p>Review and manage your selected PDF documents.</p>
        <button id="clearFilesBtn" disabled>Clear All Files</button>
        <button id="validateFilesBtn" disabled>Validate Files</button>
        <div id="upload-queue" class="output">No files selected yet.</div>
    </div>

    <div class="demo-section">
        <h3>3. Document Metadata (Optional)</h3>
        <p>Apply tags and title to all selected documents before uploading.</p>
        <div class="form-group">
            <label for="form-tags">Tags (comma separated):</label>
            <input type="text" id="form-tags" name="tags" placeholder="e.g., invoice, report, legal" class="text-input" disabled>
        </div>
        <div class="form-group">
            <label for="form-title">Document Title:</label>
            <input type="text" id="form-title" name="title" placeholder="e.g., Q3 Financial Report 2024" class="text-input" disabled>
        </div>
        <button id="previewMetadataBtn" disabled>Preview Metadata</button>
        <div id="metadataOutput" class="output">No metadata configured...</div>
    </div>

    <div class="demo-section">
        <h3>4. PDF to Markdown Conversion</h3>
        <p>Convert selected PDFs to Markdown format before upload.</p>
        <button id="setupConverterBtn" disabled>Setup PDF2MD Converter</button>
        <button id="convertAllBtn" disabled>Convert All PDFs</button>
        <button id="previewMarkdownBtn" disabled>Preview Markdown</button>
        <div class="progress-bar" style="display: none;">
            <div id="conversionProgress" class="progress-fill"></div>
        </div>
        <div id="conversionOutput" class="output">Converter not initialized...</div>
    </div>

    <div class="demo-section">
        <h3>5. Upload Progress</h3>
        <p>Monitor the upload and processing status of your documents.</p>
        <button id="startUploadBtn" disabled>Start Upload & Convert</button>
        <button id="pauseUploadBtn" disabled>Pause Upload</button>
        <button id="cancelUploadBtn" disabled>Cancel Upload</button>
        <div class="progress-bar" style="display: none;">
            <div id="uploadProgress" class="progress-fill"></div>
        </div>
        <div id="uploadStatus" class="status" style="display: none;"></div>
        <div id="uploadOutput" class="output">No upload activity...</div>
    </div>

    <div class="demo-section">
        <h3>6. Processing Results</h3>
        <p>View the results of document processing and conversion.</p>
        <button id="viewResultsBtn" disabled>View Processing Results</button>
        <button id="downloadMarkdownBtn" disabled>Download Converted Files</button>
        <button id="clearResultsBtn" disabled>Clear Results</button>
        <div id="resultsOutput" class="output">No results available...</div>
    </div>
</div>



<script src="{{ url_for('static', filename='js/upload.js') }}"></script>
{% endblock %}