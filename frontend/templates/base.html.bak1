<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF2MD Hub</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">

    <script type="importmap">
    {
      "imports": {
        "@webcontainer/api": "https://cdn.jsdelivr.net/npm/@webcontainer/api@latest/dist/index.js",
        "buffer": "https://cdn.jsdelivr.net/npm/buffer@latest/index.js"
        // No need to map "@opendocsg/pdf2md" here, as it's used *inside* the webcontainer,
        // not directly by your browser-side code.
      }
    }
    </script>

    <script type="importmap">
    {
      "imports": {
        "@webcontainer/api": "https://cdn.jsdelivr.net/npm/@webcontainer/api@1.1.0/dist/index.js",
        "buffer": "https://cdn.jsdelivr.net/npm/buffer@6.0.3/index.js"
      }
    }
  </script>

    <script type="module" src="{{ url_for('static', filename='js/pdf2md.js') }}"></script>
    <script type="module" src="{{ url_for('static', filename='js/upload.js') }}"></script>
    </head>
<body>
    <header class="app-header">
        <nav class="main-nav">
            <a href="/" class="logo">PDF2MD Hub</a>
            <ul class="nav-links">
                <li><a href="{{ url_for('upload_page') }}">Upload</a></li>
                <li><a href="{{ url_for('search_page') }}">Search</a></li>
                </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <footer class="app-footer">
        <p> PDF2MD Hub</p>
    </footer>

    
</body>
</html>