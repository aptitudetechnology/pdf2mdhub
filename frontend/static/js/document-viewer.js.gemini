// static/js/document-viewer.js

class DocumentViewer {
    constructor() {
        const container = document.getElementById('viewer-container');
        this.documentId = container ? container.dataset.documentId : null;
        this.originalFileName = container ? container.dataset.originalName : null; // Get original file name for potential use

        if (!this.documentId) {
            console.error("Document ID not found in viewer container.");
            // Optionally, redirect or display a global error if no ID
            return;
        }

        this.pdfViewer = document.getElementById('pdf-viewer');
        this.markdownViewer = document.getElementById('markdown-viewer');
        this.markdownPlaceholder = document.getElementById('markdown-placeholder'); // Placeholder for loading/error messages
        this.notesTextArea = document.getElementById('document-notes');
        this.saveNotesBtn = document.getElementById('save-notes-btn');
        this.deleteDocumentBtn = document.getElementById('delete-document-btn');
        this.editMetadataBtn = document.getElementById('edit-metadata-btn');
        this.downloadMarkdownBtn = document.getElementById('download-markdown-btn'); // New: Reference to the markdown download button

        // --- Initialize Marked.js with Highlight.js ---
        // Ensure marked and hljs are loaded before configuring
        if (typeof marked !== 'undefined' && typeof hljs !== 'undefined') {
            marked.setOptions({
                langPrefix: 'language-', // This is default, but good for hljs
                highlight: function(code, lang) {
                    const language = hljs.getLanguage(lang) ? lang : 'plaintext';
                    try {
                        return hljs.highlight(code, { language }).value;
                    } catch (error) {
                        console.warn(`Highlight.js failed to highlight language '${lang}':`, error);
                        return hljs.highlightAuto(code).value; // Fallback
                    }
                },
                gfm: true, // GitHub Flavored Markdown
                breaks: true, // Enable GFM line breaks (important for soft wraps)
                // Add your own custom renderer extensions here if needed, e.g., for custom components
                // If you are loading untrusted markdown, you MUST sanitize the output of marked.parse()
                // using a library like DOMPurify before injecting it into innerHTML to prevent XSS.
                // For example: DOMPurify.sanitize(marked.parse(markdownString));
            });
            console.info("Marked.js and Highlight.js configured successfully.");
        } else {
            console.warn("Marked.js or Highlight.js libraries not found. Markdown content will be displayed as plain text or not at all.");
        }

        this.setupEventListeners();
        this.loadDocumentData(); // Renamed from loadDocument to better reflect its purpose
        this.fetchAndRenderMarkdown(); // New: Dedicated function for markdown
    }

    setupEventListeners() {
        if (this.saveNotesBtn) {
            this.saveNotesBtn.addEventListener('click', this.saveDocumentNotes.bind(this));
        }
        if (this.deleteDocumentBtn) {
            this.deleteDocumentBtn.addEventListener('click', this.deleteDocument.bind(this));
        }
        if (this.editMetadataBtn) {
            this.editMetadataBtn.addEventListener('click', () => {
                alert('Edit Metadata functionality not yet implemented for the client-side. This would typically open a modal or navigate to an edit page.');
            });
        }
        // New: Event listener for downloading markdown
        if (this.downloadMarkdownBtn) {
            this.downloadMarkdownBtn.addEventListener('click', this.downloadMarkdown.bind(this));
        }
    }

    // New: Function to handle markdown download
    downloadMarkdown() {
        if (!this.documentId) {
            console.error("Cannot download markdown: Document ID not available.");
            return;
        }
        window.location.href = `/api/documents/${this.documentId}/download_markdown`;
    }

    // Renamed from loadDocument to clearly indicate it fetches main document data (notes etc.)
    async loadDocumentData() {
        if (!this.documentId) return;

        try {
            const response = await fetch(`/api/documents/${this.documentId}`);
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error('Document not found.');
                }
                throw new Error(`HTTP error! Status: ${response.status}`);
            }
            const documentData = await response.json(); // Renamed variable to avoid conflict

            // Display PDF in iframe (src is already set by Jinja in template, just verify)
            // The iframe's src is already correctly set by Jinja in viewer.html:
            // src="/api/documents/{{ document.id }}/download"
            // So, this block is mostly for fallback/error display, not setting the src dynamically after load.
            if (this.pdfViewer) {
                 // Check if the PDF loaded successfully or if there's a problem
                 // Note: directly manipulating iframe.contentDocument.body might be blocked by CORS
                 // The Jinja-set `src` is usually sufficient and allows browser to handle PDF.
                 // This `if (documentData.pdf_url)` check is less relevant if src is always set.
            }

            // Populate notes if available
            if (this.notesTextArea && documentData.notes) {
                this.notesTextArea.value = documentData.notes;
            }

            // Update metadata sidebar if loaded dynamically (currently server-rendered)
            // Example: updateMetadataSidebar(documentData);

        } catch (error) {
            console.error('Error loading main document data:', error);
            // Display an error message if this initial data load fails
            // Consider a more prominent error display on the page
        }
    }

    // New: Function dedicated to fetching and rendering markdown
    async fetchAndRenderMarkdown() {
        if (!this.markdownViewer) {
            console.error("Markdown viewer element not found.");
            return;
        }
        if (!this.documentId) {
             this.markdownPlaceholder.innerHTML = 'Error: Document ID not available for markdown fetch.';
             this.markdownPlaceholder.style.display = 'block';
             if (this.downloadMarkdownBtn) this.downloadMarkdownBtn.disabled = true;
             return;
        }

        // Show loading message
        this.markdownPlaceholder.innerHTML = 'Loading Markdown content...';
        this.markdownPlaceholder.style.display = 'block'; // Ensure placeholder is visible
        if (this.downloadMarkdownBtn) this.downloadMarkdownBtn.disabled = true; // Disable while loading

        try {
            const response = await fetch(`/api/documents/${this.documentId}/markdown`);

            if (!response.ok) {
                const errorData = await response.json(); // Attempt to read JSON error
                throw new Error(errorData.error || `HTTP error! Status: ${response.status}`);
            }

            const data = await response.json(); // This API returns { content: "...", ... }

            if (data.content) {
                // Hide placeholder and show content
                this.markdownPlaceholder.style.display = 'none';
                if (typeof marked !== 'undefined') {
                    this.markdownViewer.innerHTML = marked.parse(data.content);
                    // Apply highlight.js to the new content
                    // hljs.highlightAll() applies to all elements with 'language-' class
                    if (typeof hljs !== 'undefined') {
                        hljs.highlightAll();
                    }
                } else {
                    this.markdownViewer.textContent = data.content; // Fallback to plain text
                }
                if (this.downloadMarkdownBtn) this.downloadMarkdownBtn.disabled = false; // Enable button on success

            } else {
                this.markdownPlaceholder.innerHTML = 'Markdown content not found for this document.';
                this.markdownPlaceholder.style.display = 'block';
                console.warn(`No markdown content received for document ID: ${this.documentId}`);
            }
        } catch (error) {
            console.error('Error fetching or rendering markdown:', error);
            this.markdownPlaceholder.innerHTML = `Failed to load markdown content: ${error.message}`;
            this.markdownPlaceholder.style.display = 'block';
            if (this.downloadMarkdownBtn) this.downloadMarkdownBtn.disabled = true; // Keep disabled on error
        }
    }

    async saveDocumentNotes() {
        if (!this.notesTextArea || !this.documentId) return;

        const notes = this.notesTextArea.value;
        try {
            const response = await fetch(`/api/documents/${this.documentId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ notes: notes }),
            });

            if (!response.ok) {
                // Try to read error message from backend if available
                const errorData = await response.json().catch(() => ({})); // Non-JSON error fallback
                throw new Error(errorData.error || `HTTP error! Status: ${response.status}`);
            }

            const result = await response.json();
            alert('Notes saved successfully!');
            console.log('Notes save result:', result);
        } catch (error) {
            console.error('Error saving notes:', error);
            alert(`Failed to save notes: ${error.message}`);
        }
    }

    async deleteDocument() {
        if (!this.documentId) return;

        if (confirm('Are you sure you want to delete this document? This action cannot be undone.')) {
            try {
                const response = await fetch(`/api/documents/${this.documentId}`, {
                    method: 'DELETE',
                });

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.error || `HTTP error! Status: ${response.status}`);
                }

                alert('Document deleted successfully!');
                window.location.href = '/search'; // Redirect to search page or dashboard
            } catch (error) {
                console.error('Error deleting document:', error);
                alert(`Failed to delete document: ${error.message}`);
            }
        }
    }
}

// Ensure the class is instantiated once the DOM is fully loaded
document.addEventListener('DOMContentLoaded', () => {
    new DocumentViewer();
});